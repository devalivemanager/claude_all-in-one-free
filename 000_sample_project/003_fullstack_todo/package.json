{
  "name": "fullstack-todo",
  "version": "1.0.0",
  "private": true,
  "description": "풀스택 업무 할 일 관리 웹 앱 샘플 (Express + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json && esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=dist/public/app.js",
    "start": "node dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
